{
  "manifest_version": 2,
  "name": "Zotero 分类导航栏",
  "version": "1.0.0",
  "description": "在左侧收藏夹栏顶部显示当前分类的完整层级路径，每一段可点击跳转；悬停任意分类可查看完整路径。",
  "author": "informalgit",
  "homepage_url": "https://github.com/informalgit/zotero-collection-nav",
  "icons": {
    "48": "icon.svg",
    "96": "icon.svg"
  },
  "applications": {
    "zotero": {
      "id": "collection-breadcrumb@informalgit.github.io",
      "update_url": "https://raw.githubusercontent.com/informalgit/zotero-collection-nav/main/update.json",
      "strict_min_version": "7.999",
      "strict_max_version": "99.999.999"
    }
  }
}
